# Large binaries never enter the Git history. If Git LFS is chosen instead of an external archive,
# uncomment the LFS lines; otherwise these patterns are blocked by .gitignore.
# *.pt   filter=lfs diff=lfs merge=lfs -text
# *.tif  filter=lfs diff=lfs merge=lfs -text
# *.npy  filter=lfs diff=lfs merge=lfs -text
*.csv  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
